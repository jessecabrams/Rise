# Add these in Vercel: Project > Settings > Environment Variables.

# Required: the learning coach (quizzes, guides, grading, Ask).
ANTHROPIC_API_KEY=

# Required for studio voices and spoken answers on every device.
OPENAI_API_KEY=

# Strongly recommended: a passcode so only you can use your keys.
APP_PASSCODE=

# Optional: premium ElevenLabs voices with exact word timing.
ELEVENLABS_API_KEY=

# Added automatically when you connect Upstash Redis in Vercel Storage.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional model overrides.
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# ELEVENLABS_MODEL=eleven_multilingual_v2
